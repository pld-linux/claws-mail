+#else
 		struct icalrecurrencetype rrule = icalproperty_get_rrule(prop);
 		recur = g_strdup(icalrecurrencetype_as_string(&rrule));
+#endif
 		TO_UTF8(recur);
 		icalproperty_free(prop);
 	}
