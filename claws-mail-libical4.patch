+#ifdef HAVE_LIBICAL_V4
+		struct icalrecurrencetype* recur;
+#else
 		struct icalrecurrencetype recur;
+#endif
         	struct icaltimetype next;
         	icalrecur_iterator* ritr = NULL;
 		EventTime days;
@@ -559,7 +563,12 @@ static gint feed_fetch(FolderItem *fitem, MsgNumberList ** list, gboolean *old_u
 			gchar *orig_uid = NULL;
